{
  "compilerOptions": {
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["${configDir}/src/**/*"],
  "files": [],
  "references": [
    { "path": "./api" },
    { "path": "./backend" },
    { "path": "./frontend" }
  ]
}